# Open Source Village - Environment Variables
# Copy this file to .env and fill in the values

# Data directory for file-based storage
# Default: ./data
DATA_DIR=./data

# Node environment (development, production, test)
# Usually set automatically by Next.js
NODE_ENV=development

# ===========================================
# NOSTR Configuration
# ===========================================

# NOSTR relays for publishing and subscribing to events (comma-separated)
# Example: wss://relay.example.com,wss://relay2.example.com
NOSTR_RELAYS=wss://relay.opensourcevillage.org

# Server NOSTR secret key in nsec format (bech32, starts with nsec1)
# This is used by the server to:
# - Sign payment request events (kind 9734) for minting tokens on badge claims
# - Sign payment receipt events (kind 9735) after processing payments
# - Add members to NIP-29 groups
# Generate with: npx nostr-tools keygen (or any Nostr key generator)
NOSTR_NSEC=nsec1...

# ===========================================
# Token Factory Configuration
# ===========================================

# Blockchain to use for token operations
# Options: gnosis, gnosis_chiado (testnet), base, base_sepolia (testnet)
# Default: gnosis_chiado
CHAIN=gnosis_chiado

# Token contract address (set automatically when deploying a token)
# Leave empty to deploy a new token via the UI
TOKEN_ADDRESS=

# Token name and symbol (set automatically when deploying a token)
TOKEN_NAME=Community Token
TOKEN_SYMBOL=OSV

# Private key for deploying tokens and signing transactions
# A 0x-prefixed Ethereum private key
# If not set, a new key will be generated on startup (you must save it!)
PRIVATE_KEY=

# Backup private key for Safe multisig (optional)
# If same as PRIVATE_KEY or not set, 1-of-1 Safe will be created
BACKUP_PRIVATE_KEY=

# ===========================================
# Deployment Configuration
# ===========================================

# GitHub webhook secret for auto-deployment
# Generate with: openssl rand -hex 32
# Set this same value in your GitHub repository webhook settings
WEBHOOK_SECRET=

# Systemd service name to restart on deployment
# Default: osv
SERVICE_NAME=osv

# ===========================================
# Directions (/map)
# ===========================================

# MOTIS route planner used for public transport routes.
# Default: Transitous (https://transitous.org). Before heavy use, let the
# Transitous team know (see https://transitous.org/api/).
# DIRECTIONS_API_URL=https://api.transitous.org/api/v5/plan
# DIRECTIONS_USER_AGENT=OpenSourceVillage/1.0 (+https://app.opensourcevillage.org; you@example.org)

# Live STIB-MIVB waiting times at STIB stops along a route, from the
# Belgian Mobility open data portal (https://data.belgianmobility.io).
# Works without a key within the anonymous quota (100 requests/day, 10/min
# for the whole server; answers are cached 2 min). A free key from the
# portal's developer area raises the quota; answers are then cached 20 s.
STIB_API_KEY=
# Header the key is sent in (Azure API Management default)
# STIB_API_KEY_HEADER=Ocp-Apim-Subscription-Key
# Override the request budget, e.g. the limits that come with your key
# STIB_DAILY_LIMIT=
# STIB_MINUTE_LIMIT=
# Set to "off" to hide live STIB times
# STIB_LIVE_TIMES=
